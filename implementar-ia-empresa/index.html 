<script>
  const $json = [{
    businessName: "AGA Social",
    whatsappNumber: "+16574145114",
    products: [
      {
        name: "Checklist: 7 pasos para Implementar IA en tu Empresa de Servicios",
        description: "Descarga gratis esta checklist práctica para empezar a implementar inteligencia artificial en tu empresa de servicios. Incluye los 7 pasos clave para automatizar tareas, ahorrar tiempo y aumentar tus resultados sin complicaciones.",
        price: 0,
        target_audience: "Emprendedores, agencias, clínicas o negocios de servicios que quieren usar IA para ser más productivos y vender más."
      },
      {
        name: "Paquete 360°: Landing + MiniChat",
        description: "Landing Page profesional e integración con MiniChat para Instagram. Un paquete redondo y completo para captar clientes automáticamente y escalar tus ventas.",
        price: 360,
        target_audience: "Emprendedores y dueños de negocios que quieren aumentar sus ventas en Instagram con automatización y embudos inteligentes."
      }
    ]
  }];

  const AUTH_USER = "2qy53htsbgqy54uw6jtrnsdf";
  const AUTH_PASS = "gawreoigoidsfhvbqaw34gtqa3w";
  const N8N_ENDPOINT = "https://n8n.aga.social/webhook/landing-page-forms";

  function slugify(str) {
    return (str || "")
      .toString()
      .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
      .replace(/[^a-zA-Z0-9\s-]/g, '')
      .trim()
      .replace(/\s+/g, '-')
      .replace(/-+/g, '-')
      .toLowerCase();
  }

  function formatPrice(n) {
    if (Number(n) === 0) return "Gratis";
    return "USD $" + new Intl.NumberFormat('en-US', { maximumFractionDigits: 0 }).format(n);
  }

  function openModal(modalEl) {
    modalEl.classList.remove('hidden');
    document.body.classList.add('overflow-hidden');
    const focusable = modalEl.querySelector('[tabindex="-1"]') || modalEl.querySelector('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])');
    focusable && focusable.focus({ preventScroll: true });
    trapFocus(modalEl);
  }

  function closeModal(modalEl) {
    modalEl.classList.add('hidden');
    document.body.classList.remove('overflow-hidden');
    releaseTrap(modalEl);
  }

  let focusTrapHandler = null;
  function trapFocus(modalEl) {
    const selectors = 'a[href], area[href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), button:not([disabled]), [tabindex]:not([tabindex="-1"])';
    const focusables = Array.from(modalEl.querySelectorAll(selectors)).filter(el => el.offsetParent !== null);
    if (focusables.length === 0) return;
    const first = focusables[0];
    const last = focusables[focusables.length - 1];
    focusTrapHandler = (e) => {
      if (e.key === 'Escape') {
        if (modalEl.id === 'freeModal') closeModal(document.getElementById('freeModal'));
        if (modalEl.id === 'checkoutModal') closeModal(document.getElementById('checkoutModal'));
      }
      if (e.key === 'Tab') {
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault(); last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault(); first.focus();
        }
      }
    };
    document.addEventListener('keydown', focusTrapHandler);
    modalEl.addEventListener('click', (e) => {
      if (e.target === modalEl || e.target === modalEl.firstElementChild) {
        closeModal(modalEl);
      }
    }, { once: true });
  }
  function releaseTrap() {
    if (focusTrapHandler) document.removeEventListener('keydown', focusTrapHandler);
    focusTrapHandler = null;
  }

  function renderPricing() {
    const data = $json[0];
    const grid = document.getElementById('pricingGrid');
    grid.innerHTML = '';
    if (!data || !Array.isArray(data.products) || data.products.length === 0) return;

    data.products.forEach((p, idx) => {
      const isFree = Number(p.price) === 0;
      const slug = slugify(p.name);
      const card = document.createElement('div');
      card.className = "relative p-6 bg-white rounded-2xl border border-slate-200 shadow-sm hover:shadow-xl transition animate-fade-up";
      card.innerHTML = `
        <div class="absolute -top-3 -right-3 bg-xmas-gold text-xmas-red text-xs font-bold px-3 py-1 rounded-full shadow">Navidad</div>
        <div class="flex items-start justify-between gap-4">
          <div>
            <h3 class="font-display text-xl font-bold">${p.name}</h3>
            <p class="mt-1 text-slate-600 text-sm">${p.description}</p>
          </div>
          <span class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-xmas-red/10 text-xmas-red">
            <span class="material-symbols-rounded">${isFree ? 'download' : 'shopping_bag'}</span>
          </span>
        </div>
        <div class="mt-5 p-4 rounded-xl bg-cream border border-slate-200">
          <p class="text-sm text-slate-500">Ideal para</p>
          <p class="font-medium text-slate-800">${p.target_audience || ''}</p>
        </div>
        <div class="mt-6 flex items-end justify-between">
          <div>
            <div class="text-2xl font-extrabold ${isFree ? 'text-xmas-green' : 'text-xmas-red'}">${formatPrice(p.price)}</div>
            <p class="text-xs text-slate-500">${isFree ? 'Recurso 100% gratuito' : 'Incluye garantía de satisfacción'}</p>
          </div>
          <div class="flex items-center gap-2 text-xs text-slate-500">
            <span class="material-symbols-rounded text-xmas-gold">verified</span> Pago seguro
          </div>
        </div>
        <div class="mt-5 flex flex-col sm:flex-row gap-3">
          <button data-idx="${idx}" class="primary-cta inline-flex items-center justify-center gap-2 ${isFree ? 'bg-xmas-green hover:bg-pine' : 'bg-xmas-red hover:bg-xmas-redDark'} text-white px-5 py-2.5 rounded-xl transition focus-ring">
            <span class="material-symbols-rounded">${isFree ? 'file_download' : 'bolt'}</span>
            ${isFree ? 'Descargar gratis' : 'Comprar ahora'}
          </button>
          <a href="https://wa.me/${encodeURIComponent(data.whatsappNumber)}?text=${encodeURIComponent('Hola! Estoy interesado en tu producto: ' + p.name)}" target="_blank" class="inline-flex items-center justify-center gap-2 border border-slate-300 text-slate-700 px-5 py-2.5 rounded-xl hover:bg-slate-50 transition focus-ring">
            <span class="material-symbols-rounded">chat</span> Consultar por WhatsApp
          </a>
        </div>
        ${!isFree ? `
          <div class="mt-4 text-xs text-slate-600 flex items-center gap-3 flex-wrap">
            <span class="inline-flex items-center gap-1"><span class="material-symbols-rounded text-xmas-gold">shield</span> Protección de pago</span>
            <span class="inline-flex items-center gap-1"><span class="material-symbols-rounded text-xmas-gold">rebase</span> Soporte dedicado</span>
            <span class="inline-flex items-center gap-1"><span class="material-symbols-rounded text-xmas-gold">schedule</span> Entrega express</span>
          </div>
        ` : ''}
      `;
      grid.appendChild(card);

      const cta = card.querySelector('.primary-cta');
      cta.addEventListener('click', () => {
        if (isFree) openFree(p);
        else openCheckout(p);
      });
    });
  }

  function openFree(product) {
    const modal = document.getElementById('freeModal');
    const title = document.getElementById('freeModalTitle');
    const subtitle = document.getElementById('freeModalSubtitle');
    const fromEventInput = document.getElementById('fromEvent');
    const productNameInput = document.getElementById('productName');
    const freeWhatsapp = document.getElementById('freeWhatsapp');
    const slug = slugify(product.name);
    title.textContent = "Descarga: " + product.name;
    subtitle.textContent = "Te enviaremos la checklist por correo y la descarga iniciará automáticamente.";
    fromEventInput.value = slug;
    productNameInput.value = product.name;
    const wa = `https://wa.me/${encodeURIComponent($json[0].whatsappNumber)}?text=${encodeURIComponent('Hola! Tengo una duda sobre la descarga: ' + product.name)}`;
    freeWhatsapp.href = wa;
    openModal(modal);
  }

  function openCheckout(product) {
    const modal = document.getElementById('checkoutModal');
    const title = document.getElementById('checkoutTitle');
    const checkoutWhatsapp = document.getElementById('checkoutWhatsapp');
    title.textContent = "Checkout — " + product.name;
    const wa = `https://wa.me/${encodeURIComponent($json[0].whatsappNumber)}?text=${encodeURIComponent('Hola! Quiero comprar: ' + product.name)}`;
    checkoutWhatsapp.href = wa;
    openModal(modal);
  }

  function setupModals() {
    const freeModal = document.getElementById('freeModal');
    const checkoutModal = document.getElementById('checkoutModal');
    freeModal.querySelector('[data-close-free]').addEventListener('click', () => closeModal(freeModal));
    checkoutModal.querySelector('[data-close-checkout]').addEventListener('click', () => closeModal(checkoutModal));
  }

  function setupWhatsAppCTAs() {
    const phone = $json[0].whatsappNumber || '+16574145114';
    const encoded = `https://wa.me/${encodeURIComponent(phone)}?text=${encodeURIComponent('Hola! Estoy interesado en tu producto')}`;
    document.getElementById('whatsappFloat').href = encoded;
    document.getElementById('heroWhatsapp').href = encoded;
    document.getElementById('navWhatsapp').href = encoded;
    document.getElementById('ctaWhatsapp').href = encoded;
  }

  function validateEmail(email) {
    return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email);
  }

  function setupFreeForm() {
    const form = document.getElementById('freeForm');
    const btn = document.getElementById('freeSubmit');
    const msg = document.getElementById('formMsg');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = document.getElementById('name').value.trim();
      const email = document.getElementById('email').value.trim();
      const phone = document.getElementById('phone').value.trim();
      const fromEvent = document.getElementById('fromEvent').value;
      const productName = document.getElementById('productName').value;
      const privacy = document.getElementById('privacy').checked;

      const nameError = document.getElementById('nameError');
      const emailError = document.getElementById('emailError');
      nameError.classList.add('hidden');
      emailError.classList.add('hidden');
      msg.classList.add('hidden');
      msg.textContent = '';
      msg.className = 'text-sm hidden';

      let valid = true;
      if (name.length < 2) { nameError.classList.remove('hidden'); valid = false; }
      if (!validateEmail(email)) { emailError.classList.remove('hidden'); valid = false; }
      if (!privacy) { 
        msg.textContent = 'Por favor acepta la política de privacidad.';
        msg.className = 'text-sm text-red-600';
        msg.classList.remove('hidden');
        valid = false;
      }
      if (!valid) return;

      btn.disabled = true;
      btn.innerHTML = '<span class="material-symbols-rounded animate-spin">progress_activity</span> Enviando...';

      try {
        const payload = {
          name, email, phone, fromEvent,
          productName,
          businessName: $json[0].businessName || 'AGA Social',
          source: 'landing',
          timestamp: new Date().toISOString()
        };
        const res = await fetch(N8N_ENDPOINT, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': 'Basic ' + btoa(AUTH_USER + ':' + AUTH_PASS)
          },
          body: JSON.stringify(payload)
        });
        if (!res.ok) throw new Error('Error de envío');

        msg.textContent = '¡Listo! Te enviamos el recurso a tu correo. La descarga iniciará automáticamente.';
        msg.className = 'text-sm text-xmas-green';
        msg.classList.remove('hidden');

        const slug = fromEvent;
        const link = document.createElement('a');
        link.href = '/downloads/' + slug + '.pdf';
        link.download = '';
        document.body.appendChild(link);
        link.click();
        link.remove();

        setTimeout(() => {
          btn.disabled = false;
          btn.innerHTML = '<span class="material-symbols-rounded">download</span> Descargar ahora';
          closeModal(document.getElementById('freeModal'));
          form.reset();
        }, 1800);
      } catch (err) {
        msg.textContent = 'Hubo un problema. Intenta nuevamente o contáctanos por WhatsApp.';
        msg.className = 'text-sm text-red-600';
        msg.classList.remove('hidden');
        btn.disabled = false;
        btn.innerHTML = '<span class="material-symbols-rounded">download</span> Descargar ahora';
      }
    });
  }

  function animateOnScroll() {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('in-view');
          observer.unobserve(e.target);
        }
      });
    }, { threshold: 0.15 });
    document.querySelectorAll('.animate-fade-up, .animate-appear').forEach(el => observer.observe(el));
  }

  function setYear() {
    document.getElementById('year').textContent = new Date().getFullYear();
  }

  document.addEventListener('DOMContentLoaded', () => {
    setupWhatsAppCTAs();
    renderPricing();
    setupModals();
    setupFreeForm();
    animateOnScroll();
    setYear();
  });
</script>
</body>
